---
import { NAV_ITEMS, LINKS, SITE_NAME } from '../config';

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(href + '/');
}
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand">{SITE_NAME}</a>

    <nav class="nav-desktop" aria-label="Primary">
      {NAV_ITEMS.map((item) => (
        <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <button
      class="menu-toggle"
      id="menu-toggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav aria-label="Primary">
      <ul>
        {NAV_ITEMS.map((item) => (
          <li>
            <a href={item.href} class:list={['mobile-nav-link', { active: isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
        <li>
          <a href={`mailto:${LINKS.email}`} class="mobile-nav-link">{LINKS.email}</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: var(--surface);
    border-bottom: 1px solid var(--rule);
  }

  .header-inner {
    height: var(--header-height-mobile);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  @media (min-width: 900px) {
    .header-inner {
      height: var(--header-height);
    }
  }

  .brand {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 17px;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }

  @media (min-width: 900px) {
    .brand {
      font-size: 19px;
    }
  }

  .brand:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .nav-desktop {
    display: none;
    align-items: center;
    gap: var(--space-6);
  }

  @media (min-width: 900px) {
    .nav-desktop {
      display: flex;
    }
  }

  .nav-link {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 15px;
    color: var(--ink-2);
    text-decoration: none;
    padding-block: 4px;
    border-bottom: 2px solid transparent;
  }

  .nav-link:hover {
    color: var(--ink);
    text-decoration: none;
  }

  .nav-link.active {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }

  .menu-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    color: var(--ink);
    cursor: pointer;
  }

  @media (min-width: 900px) {
    .menu-toggle {
      display: none;
    }
  }

  .mobile-menu {
    position: fixed;
    inset: var(--header-height-mobile) 0 0 0;
    background-color: var(--paper);
    z-index: 49;
    overflow-y: auto;
  }

  .mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: var(--space-6) var(--pad-mobile);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .mobile-nav-link {
    font-family: var(--font-serif);
    font-size: 28px;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    display: block;
    min-height: 44px;
  }

  .mobile-nav-link.active {
    color: var(--accent);
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = !menu.hidden;
      menu.hidden = isOpen;
      toggle.setAttribute('aria-expanded', String(!isOpen));
      toggle.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
      document.body.style.overflow = isOpen ? '' : 'hidden';
    });
  }
</script>
