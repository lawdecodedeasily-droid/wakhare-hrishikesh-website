---
import BaseLayout from '../layouts/BaseLayout.astro';
import { NAV_ITEMS } from '../config';
---

<BaseLayout title="Page not found — Hrishikesh A. C. Wakhare" description="This page could not be found.">
  <section class="section not-found">
    <div class="container">
      <p class="label">404</p>
      <h1>Page not found</h1>
      <p class="not-found-text">The page you're looking for doesn't exist or has moved.</p>
      <nav aria-label="Site sections">
        <ul class="not-found-links">
          <li><a href="/">Home</a></li>
          {NAV_ITEMS.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    text-align: center;
    min-height: 50vh;
    display: flex;
    align-items: center;
  }

  .not-found .container {
    width: 100%;
  }

  .not-found .label {
    color: var(--ochre);
    margin-bottom: var(--space-4);
  }

  .not-found-text {
    color: var(--ink-2);
    margin-inline: auto;
    margin-bottom: var(--space-7);
  }

  .not-found-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-5);
  }

  .not-found-links a {
    font-weight: 500;
  }
</style>
